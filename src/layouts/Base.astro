---
import "../styles/site.css";

interface Props {
  title: string;
  description: string;
  path: string;
  wide?: boolean;
}

const { title, description, path, wide = false } = Astro.props;
const base = "https://pedagog.beliberde.net";
const canonical = new URL(path, base).href;

const nav = [
  { href: "/programs", label: "Программы" },
  { href: "/apply", label: "Записаться" },
  { href: "/legal", label: "Документы" },
  { href: "/about", label: "О центре" },
];

// /program и /program/<slug> относятся к разделу «Программы».
const isActive = (href: string) =>
  href === "/programs"
    ? path === "/programs" || path.startsWith("/program")
    : path === href || path.startsWith(`${href}/`);
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Учебный центр" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <header class="top">
      <div class="top__brand">
        <p class="top__kicker">Учебный центр</p>
        <p class="top__name"><a href="/">Программы для специалистов</a></p>
      </div>
      <nav class="nav" aria-label="Разделы сайта">
        {
          nav.map((item) => (
            <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
              {item.label}
            </a>
          ))
        }
      </nav>
    </header>

    <main class:list={[{ wide }]}>
      <slot />
    </main>

    <footer class="foot">
      <p>Учебный центр. Программы для психологов и помогающих специалистов.</p>
      <p class="placeholder">Сведения о лицензии партнёра: уточняются.</p>
      <div class="foot__links">
        <a href="/programs">Программы</a>
        <a href="/apply">Записаться</a>
        <a href="/legal">Документы</a>
        <a href="/about">О центре</a>
      </div>
    </footer>
  </body>
</html>
